{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true
  },
  // Node-only fixture tables; they are compiled separately by
  // `npm run test:placement`, which supplies @types/node.
  // `test/` holds Node-only mocks/shims for `npm test` (tsconfig.test.json).
  "exclude": ["**/__tests__/**", ".test-out", "test"]
}
